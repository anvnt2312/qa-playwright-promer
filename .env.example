# ============================================================
# .env.example — TEMPLATE chung (an toàn để commit lên Git)
# Sao chép file này thành .env rồi điền thông tin thật vào
#   cp .env.example .env
# ============================================================

# ── Thông tin đăng nhập ──────────────────────────────────────
TEST_EMAIL=your-email@example.com
TEST_PASSWORD=your-password

# ── URL môi trường ────────────────────────────────────────────
BASE_URL=https://app.promer.ai

# ── Timeout (đơn vị: milliseconds) ───────────────────────────
TEST_TIMEOUT=30000          # mỗi test tối đa 30 giây
EXPECT_TIMEOUT=5000         # expect().toBeVisible() tối đa 5 giây
NAVIGATION_TIMEOUT=15000    # page.goto() tối đa 15 giây
ACTION_TIMEOUT=10000        # click/fill tối đa 10 giây

# ── Test runner ────────────────────────────────────────────────
RETRIES=1                   # retry 1 lần nếu test fail
WORKERS=2                   # 2 browser chạy song song
FULLY_PARALLEL=true         # test trong 1 file cũng chạy song song
MAX_FAILURES=0              # 0 = chạy hết dù có fail
HEADLESS=true               # không mở cửa sổ browser
SLOW_MO=0                   # không làm chậm action
