# ============================================================
# .env.staging.example — TEMPLATE môi trường STAGING
# Dùng khi test trên server staging trước khi đẩy production
#   cp .env.staging.example .env.staging
#   TEST_ENV=staging npx playwright test
# ============================================================

# Tài khoản test riêng cho staging (khác với production)
TEST_EMAIL=qa-tester@example.com
TEST_PASSWORD=staging-password

# URL staging — thay bằng URL thật khi có
BASE_URL=https://staging.promer.ai

TEST_TIMEOUT=30000
EXPECT_TIMEOUT=5000
NAVIGATION_TIMEOUT=15000
ACTION_TIMEOUT=10000

# Staging: retry 1 lần (network staging đôi khi chậm)
RETRIES=1

WORKERS=2
FULLY_PARALLEL=true
HEADLESS=true
SLOW_MO=0
