# ============================================================
# .env.local.example — TEMPLATE môi trường LOCAL
# Dùng khi debug, xem test chạy, viết test mới
#   cp .env.local.example .env.local
#   TEST_ENV=local npx playwright test
# ============================================================

TEST_EMAIL=your-email@example.com
TEST_PASSWORD=your-password

BASE_URL=https://app.promer.ai

# Local: timeout dài hơn để có thời gian debug
TEST_TIMEOUT=60000
EXPECT_TIMEOUT=10000
NAVIGATION_TIMEOUT=30000
ACTION_TIMEOUT=15000

# Local: không retry — flaky phải lộ ra ngay
RETRIES=0

# Local: 1 worker — dễ theo dõi hơn
WORKERS=1
FULLY_PARALLEL=false

# Local: mở browser để xem test chạy
HEADLESS=false

# Local: làm chậm 500ms mỗi action để dễ quan sát
# Tăng lên 1000 nếu cần xem chậm hơn
SLOW_MO=500
